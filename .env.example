# Database (Supabase PostgreSQL via Prisma)
DATABASE_URL="postgresql://user:password@host:5432/postgres"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Cashfree Payments (v2025-01-01) - Server Only Secrets (No NEXT_PUBLIC_)
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"
CASHFREE_ENVIRONMENT="sandbox" # "sandbox" | "production"

# Cloudflare R2 Storage (Customer Designs & Mockups)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key"
R2_SECRET_ACCESS_KEY="your_r2_secret_key"
R2_BUCKET_NAME="starby-designs"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"

# Resend Email Delivery
RESEND_API_KEY="re_123456789"
EMAIL_FROM="StarBy <orders@starby.in>"
ADMIN_EMAIL="admin@starby.in"

# Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Site Domain
NEXT_PUBLIC_SITE_URL="https://starby.in"

# Tawk.to Live Chat
NEXT_PUBLIC_TAWKTO_PROPERTY_ID=""
NEXT_PUBLIC_TAWKTO_WIDGET_ID=""
