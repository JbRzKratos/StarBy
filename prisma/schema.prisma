datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Catalogue (editable by admin, served to public) ─────────────────────────

model Category {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String
  tagline      String
  productCount Int      @default(0)
  featured     Boolean  @default(false)
  gradient     String
  image        String?  // R2 URL
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id           String           @id @default(cuid())
  slug         String           @unique
  name         String
  tagline      String
  description  String
  categorySlug String
  basePrice    Float
  customizable Boolean          @default(false)
  tags         String[]
  featured     Boolean          @default(false)
  sizes        String[]
  variants     ProductVariant[]
  reviews      Review[]
  wishlistItems WishlistItem[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model ProductVariant {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name             String
  color            String
  colorHex         String
  price            Float
  images           String[] // R2 URLs
  inStock          Boolean  @default(true)
  stockQuantity    Int      @default(0)
  reorderThreshold Int      @default(5)
}

// ─── User & Auth ─────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id        String   @id
  email     String   @unique
  fullName  String?
  phone     String?
  role      Role     @default(CUSTOMER)
  notes     String?  // staff-only CRM notes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses     Address[]
  orders        Order[]
  designs       CustomizerDesign[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  files         StoredFile[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  street    String
  city      String
  state     String
  zip       String
  country   String   @default("India")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id                      String   @id @default(cuid())
  publicOrderId           String?  @unique
  userId                  String?
  user                    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  subtotal                Float    @default(0)
  discount                Float?   @default(0)
  shippingFee             Float    @default(0)
  tax                     Float    @default(0)
  total                   Float
  currency                String   @default("INR")
  status                  String   @default("pending_payment")
  paymentStatus           String   @default("pending")
  paymentProvider         String?
  paymentGatewayOrderId   String?
  paymentGatewayPaymentId String?
  shippingAddress         Json
  couponCode              String?
  estimatedDeliveryDate   DateTime?
  shippingMethod          String?  @default("standard")
  trackingNumber          String?
  trackingUrl             String?
  carrier                 String?
  internalNotes           String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  files         StoredFile[]
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  variantId           String
  productNameSnapshot String?
  skuSnapshot         String?
  quantity            Int
  price               Float?   @default(0)
  unitPrice           Float    @default(0)
  totalPrice          Float    @default(0)
  size                String?
  customization       Json?
  orderCustomization  OrderCustomization?
  createdAt           DateTime @default(now())
}

model OrderCustomization {
  id                String    @id @default(cuid())
  orderItemId       String    @unique
  orderItem         OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  designFileUrl     String?
  designFileKey     String?
  designFileName    String?
  designFileType    String?
  designFileSize    Int?
  printPosition     String?
  printInstructions String?
  customerNotes     String?
  previewFileUrl    String?
  productionStatus  String    @default("pending")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  oldStatus String?
  newStatus String
  changedBy String?
  note      String?
  createdAt DateTime @default(now())
}

// ─── Webhook Idempotency ──────────────────────────────────────────────────────

model WebhookEvent {
  id           String   @id @default(cuid())
  provider     String
  eventId      String
  eventType    String
  orderId      String?
  payload      Json?
  processedAt  DateTime @default(now())

  @@unique([provider, eventId])
}

// ─── Customizer Designs ───────────────────────────────────────────────────────

model CustomizerDesign {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId   String
  canvasState Json
  previewUrl  String?
  title       String?  @default("My Design")
  createdAt   DateTime @default(now())
}

// ─── Coupons ─────────────────────────────────────────────────────────────────

model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique
  discountType     String
  discountValue    Float
  isActive         Boolean   @default(true)
  expiresAt        DateTime?
  maxUses          Int?
  perCustomerLimit Int?
  minOrderValue    Float?    @default(0)
  usageCount       Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ─── Reviews & Wishlist ───────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  rating    Int
  title     String?
  text      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ─── Store Config (admin-editable) ───────────────────────────────────────────

model StoreSettings {
  id           String   @id @default("singleton")
  storeName    String   @default("StarBy")
  contactEmail String   @default("")
  logoUrl      String?
  taxRate      Float    @default(0)
  newOrderEmail Boolean @default(true)
  updatedAt    DateTime @updatedAt
}

model ShippingZone {
  id        String   @id @default(cuid())
  name      String
  states    String[]
  rateType  String   // 'flat' | 'per_item'
  rateValue Float
  createdAt DateTime @default(now())
}

// ─── Newsletter ───────────────────────────────────────────────────────────────

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ─── File Storage Metadata (Cloudflare R2) ────────────────────────────────────

model StoredFile {
  id               String   @id @default(cuid())
  ownerUserId      String?
  user             User?    @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  orderId          String?
  order            Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItemId      String?
  fileType         String   // 'customer_design' | 'production_artwork' | 'invoice' | 'proof'
  storageProvider  String   @default("cloudflare_r2")
  bucket           String
  objectKey        String   @unique
  originalFilename String
  mimeType         String
  fileSize         Int      @default(0)
  isPrivate        Boolean  @default(true)
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ownerUserId])
  @@index([orderId])
  @@index([fileType])
}
