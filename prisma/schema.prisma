generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String
  tagline      String
  productCount Int      @default(0)
  featured     Boolean  @default(false)
  gradient     String
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id            String           @id @default(cuid())
  slug          String           @unique
  name          String
  tagline       String
  description   String
  categorySlug  String
  basePrice     Float
  customizable  Boolean          @default(false)
  tags          String[]
  featured      Boolean          @default(false)
  sizes         String[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  variants      ProductVariant[]
  reviews       Review[]
  wishlistItems WishlistItem[]
}

model ProductVariant {
  id               String   @id @default(cuid())
  productId        String
  name             String
  color            String
  colorHex         String
  price            Float
  images           String[]
  inStock          Boolean  @default(true)
  reorderThreshold Int      @default(5)
  stockQuantity    Int      @default(0)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model User {
  id            String             @id
  email         String             @unique
  fullName      String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  role          Role               @default(CUSTOMER)
  notes         String?
  phone         String?
  addresses     Address[]
  designs       CustomizerDesign[]
  orders        Order[]
  reviews       Review[]
  files         StoredFile[]
  wishlistItems WishlistItem[]
  bulkOrders    BulkOrderRequest[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  name      String
  street    String
  city      String
  state     String
  zip       String
  country   String   @default("India")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  phone     String?
  updatedAt DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id                      String               @id @default(cuid())
  userId                  String?
  total                   Float
  status                  String               @default("pending_payment")
  paymentStatus           String               @default("pending")
  shippingAddress         Json
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  couponCode              String?
  discount                Float?               @default(0)
  estimatedDeliveryDate   DateTime?
  shippingMethod          String?              @default("standard")
  internalNotes           String?
  carrier                 String?
  trackingNumber          String?
  trackingUrl             String?
  currency                String               @default("INR")
  paymentGatewayOrderId   String?
  paymentGatewayPaymentId String?
  paymentProvider         String?
  publicOrderId           String?              @unique
  shippingFee             Float                @default(0)
  subtotal                Float                @default(0)
  tax                     Float                @default(0)
  user                    User?                @relation(fields: [userId], references: [id])
  items                   OrderItem[]
  statusHistory           OrderStatusHistory[]
  files                   StoredFile[]
}

model OrderItem {
  id                  String              @id @default(cuid())
  orderId             String
  productId           String
  variantId           String
  quantity            Int
  price               Float?              @default(0)
  size                String?
  customization       Json?
  createdAt           DateTime            @default(now())
  productNameSnapshot String?
  skuSnapshot         String?
  totalPrice          Float               @default(0)
  unitPrice           Float               @default(0)
  orderCustomization  OrderCustomization?
  order               Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderCustomization {
  id                String    @id @default(cuid())
  orderItemId       String    @unique
  designFileUrl     String?
  designFileKey     String?
  designFileName    String?
  designFileType    String?
  designFileSize    Int?
  printPosition     String?
  printInstructions String?
  customerNotes     String?
  previewFileUrl    String?
  productionStatus  String    @default("pending")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  orderItem         OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  oldStatus String?
  newStatus String
  changedBy String?
  note      String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  orderId     String?
  payload     Json?
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
}

model CustomizerDesign {
  id          String   @id @default(cuid())
  userId      String?
  productId   String
  canvasState Json
  previewUrl  String?
  title       String?  @default("My Design")
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
}

model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique
  discountType     String
  discountValue    Float
  isActive         Boolean   @default(true)
  expiresAt        DateTime?
  maxUses          Int?
  usageCount       Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  minOrderValue    Float?    @default(0)
  perCustomerLimit Int?
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  title     String?
  text      String?
  userId    String
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model StoreSettings {
  id            String   @id @default("singleton")
  storeName     String   @default("StarBy")
  contactEmail  String   @default("")
  logoUrl       String?
  taxRate       Float    @default(0)
  newOrderEmail Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model ShippingZone {
  id        String   @id @default(cuid())
  name      String
  states    String[]
  rateType  String
  rateValue Float
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model StoredFile {
  id               String   @id @default(cuid())
  ownerUserId      String?
  orderId          String?
  orderItemId      String?
  fileType         String
  storageProvider  String   @default("cloudflare_r2")
  bucket           String
  objectKey        String   @unique
  originalFilename String
  mimeType         String
  fileSize         Int      @default(0)
  isPrivate        Boolean  @default(true)
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  order            Order?   @relation(fields: [orderId], references: [id])
  user             User?    @relation(fields: [ownerUserId], references: [id])

  @@index([ownerUserId])
  @@index([orderId])
  @@index([fileType])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model CustomerWallPhoto {
  id        String   @id
  userId    String?
  wallId    String?
  imageUrl  String
  caption   String?
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model CustomizationTemplate {
  id          String @id
  productId   String @unique
  mockupImage String
  printArea   Json
  blendMode   String @default("source-over")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model DeviceSkinTemplate {
  id           String   @id
  name         String
  brand        String
  type         String
  aspectRatio  Float
  borderRadius Float
  cameraModule Json?
  logoCutout   Json?
  sPenSilo     Boolean  @default(false)
  confidence   String
  notes        String?
  createdAt    DateTime @default(now())
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model PosterArtwork {
  id                String   @id
  title             String
  slug              String   @unique
  artist            String?  @default("Fregoro Studio")
  description       String?
  themeSlug         String
  category          String   @default("art")
  subcategory       String?
  tags              String[]
  orientation       String   @default("portrait")
  availableSizes    String[]
  productType       String   @default("poster")
  isSplitCompatible Boolean  @default(false)
  heroCompatible    Boolean  @default(true)
  supportCompatible Boolean  @default(true)
  dominantColor     String?
  secondaryColor    String?
  brightness        String?  @default("mid")
  mood              String?  @default("cinematic")
  imageUrl          String
  thumbnailUrl      String?
  price             Float    @default(99)
  status            String   @default("published")
  featured          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime

  @@index([category])
  @@index([orientation])
  @@index([themeSlug])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model PrebuiltWallProduct {
  id             String   @id
  slug           String   @unique
  title          String
  tagline        String
  description    String
  themeSlug      String
  layoutId       String
  basePrice      Float
  compareAtPrice Float?
  heroImage      String
  roomPhoto      String?
  presetSlots    Json
  material       String   @default("280 GSM Archival Matte Paper with Giclée Inks")
  whatsIncluded  String[]
  featured       Boolean  @default(false)
  rating         Float    @default(4.9)
  reviewCount    Int      @default(28)
  createdAt      DateTime @default(now())
  updatedAt      DateTime
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model SavedWall {
  id            String   @id
  userId        String?
  title         String   @default("My Wall")
  layoutId      String
  layoutVersion Int      @default(1)
  slotsData     Json
  previewUrl    String?
  isPublic      Boolean  @default(false)
  shareCode     String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime

  @@index([shareCode])
  @@index([userId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model WallLayout {
  id                   String   @id
  name                 String
  slug                 String   @unique
  description          String
  badge                String?
  wallWidthMm          Int      @default(1600)
  wallHeightMm         Int      @default(1050)
  coverageLabel        String   @default("160 × 105 cm")
  physicalPrintCount   Int      @default(5)
  logicalArtworkCount  Int      @default(5)
  recommendedRoom      String?  @default("Living Room / Feature Wall")
  recommendedWallWidth String?  @default("2.0 – 2.5 m")
  recommendedThemes    String[]
  basePrice            Float    @default(699)
  compareAtPrice       Float?
  slots                Json
  splitGroups          Json?
  published            Boolean  @default(true)
  version              Int      @default(1)
  previewImage         String?
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model WallLayoutVersion {
  id           String   @id
  layoutId     String
  version      Int
  slots        Json
  splitGroups  Json?
  wallWidthMm  Int
  wallHeightMm Int
  createdAt    DateTime @default(now())

  @@unique([layoutId, version])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model WallTheme {
  id           String   @id
  slug         String   @unique
  name         String
  tagline      String?
  description  String?
  accentColor  String?  @default("#3B5EFF")
  gradient     String?
  previewImage String?
  featured     Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

model BulkOrderRequest {
  id                    String                   @id @default(cuid())
  requestNumber         String                   @unique
  userId                String?
  orderType             String                   // Corporate, College, School, Event, Sports Team, Wedding, Birthday, Festival, Brand Merchandise, Creator Merchandise, Club / Community, Other
  eventName             String?
  companyName           String?
  contactName           String
  phone                 String
  email                 String
  estimatedQuantity     Int?
  totalQuantity         Int                      @default(0)
  requiredDeliveryDate  DateTime?
  eventDate             DateTime?
  isUrgent              Boolean                  @default(false)
  websiteOrSocial       String?
  budgetRange           String?
  contactPreference     String                   @default("whatsapp") // whatsapp, phone, email
  customerNotes         String?
  shippingMethod        String                   @default("delivery") // delivery, pickup
  shippingAddress       Json?
  packagingPreference   String?                  // individual, bulk, custom, no_preference
  packagingNotes        String?
  customLabelOption     String?                  // none, neck_label, woven_label, printed_label, custom_packaging, hang_tags, stickers, other
  customLabelNotes      String?
  status                String                   @default("new") // new, under_review, need_more_info, quote_sent, customer_reviewing, approved, payment_pending, paid, production, quality_check, packed, shipped, completed, cancelled
  adminNotes            String?
  user                  User?                    @relation(fields: [userId], references: [id])
  items                 BulkOrderItem[]
  artworks              BulkOrderArtwork[]
  quotes                BulkOrderQuote[]
  messages              BulkOrderMessage[]
  statusHistory         BulkOrderStatusHistory[]
  emailEvents           EmailEvent[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([requestNumber])
  @@index([userId])
  @@index([status])
}

model BulkOrderItem {
  id                 String           @id @default(cuid())
  requestId          String
  request            BulkOrderRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  apparelType        String           // e.g. "Oversized T-Shirt", "Regular Fit T-Shirt", "Hoodie"
  productId          String?
  fabric             String?          // e.g. "100% Combed Cotton", "240 GSM"
  gsm                String?
  printingMethod     String?          // DTF, Screen Printing, Sublimation, Embroidery, Vinyl, Not Sure, Recommend for me
  printingPlacements String[]         // ['front', 'back', 'sleeve_left', etc.]
  designNotes        String?
  totalQuantity      Int              @default(0)
  sizeColorMatrix    Json             // Array of { colorName: string, colorHex?: string, quantities: Record<string, number>, total: number }
  createdAt          DateTime         @default(now())
}

model BulkOrderArtwork {
  id           String           @id @default(cuid())
  requestId    String
  request      BulkOrderRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  placement    String           // front, back, sleeve_left, sleeve_right, chest_logo, neck_label, other
  label        String?
  fileUrl      String
  fileKey      String?
  fileName     String
  fileType     String
  fileSize     Int?
  printSize    String?          // Small, Medium, Large, Oversized, Custom
  dimensionsMm String?          // e.g. "300 × 400 mm"
  notes        String?
  status       String           @default("received") // received, needs_revision, approved, rejected
  adminNotes   String?
  createdAt    DateTime         @default(now())
}

model BulkOrderQuote {
  id                      String           @id @default(cuid())
  requestId               String
  request                 BulkOrderRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  version                 Int              @default(1)
  status                  String           @default("sent") // draft, sent, accepted, rejected, expired, superseded
  garmentPrice            Float            @default(0)
  printingPrice           Float            @default(0)
  setupFee                Float            @default(0)
  packagingFee            Float            @default(0)
  shippingFee             Float            @default(0)
  urgencyFee              Float            @default(0)
  otherFees               Float            @default(0)
  subtotal                Float            @default(0)
  discount                Float            @default(0)
  tax                     Float            @default(0)
  total                   Float            @default(0)
  currency                String           @default("INR")
  notes                   String?
  lineItems               Json?
  expiresAt               DateTime?
  acceptedAt              DateTime?
  paidAt                  DateTime?
  paymentGatewayOrderId   String?
  paymentGatewayPaymentId String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
}

model BulkOrderStatusHistory {
  id        String           @id @default(cuid())
  requestId String
  request   BulkOrderRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  oldStatus String?
  newStatus String
  changedBy String           @default("system")
  note      String?
  createdAt DateTime         @default(now())
}

model BulkOrderMessage {
  id         String           @id @default(cuid())
  requestId  String
  request    BulkOrderRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender     String           // admin, customer
  senderName String?
  message    String
  createdAt  DateTime         @default(now())
}

model ContactSubmission {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  company     String?
  subject     String
  message     String
  status      String   @default("new") // new, read, replied, closed
  emailStatus String   @default("pending") // pending, sent, failed
  emailError  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([email])
}

model EmailEvent {
  id                String            @id @default(cuid())
  requestId         String?
  request           BulkOrderRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  type              String            // contact_admin, contact_customer, bulk_admin, bulk_customer, quote_customer, status_customer
  recipient         String
  subject           String
  providerMessageId String?
  status            String            @default("pending") // pending, sent, delivered, bounced, failed
  error             String?
  payload           Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([requestId])
  @@index([type])
  @@index([status])
  @@index([recipient])
}


